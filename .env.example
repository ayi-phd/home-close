# Copy to .env for local development. Never commit .env.

# --- MongoDB (docker-compose.yml) ---
MONGO_USER=homeclose
# Use letters and digits only; the password is embedded in MONGODB_URI below.
MONGO_PASSWORD=change-me-locally
MONGO_PORT=27017

# --- API server (server/) ---
# NODE_ENV is not set here: the server defaults to development, and Vite (which also reads this
# file) must decide it per command. Set NODE_ENV=production only in deployed environments.
PORT=3000
MONGODB_URI=mongodb://homeclose:change-me-locally@localhost:27017/homeclose?authSource=admin
# IANA time zone that decides the household's "today".
APP_TIME_ZONE=America/Los_Angeles
# Optional: pin "today" (YYYY-MM-DD) to work with the October 2026 sample data from `npm run seed`.
# Rejected when NODE_ENV=production.
FIXED_TODAY=2026-10-07

# --- Client (client/, Vite exposes only VITE_-prefixed variables to the browser) ---
# http (default): talk to the API. mock: in-memory sample data, no server needed.
VITE_API_MODE=http
# Base URL of the REST API as seen by the browser.
VITE_API_BASE_URL=/api/v1
# Dev server only: where Vite proxies /api requests.
API_PROXY_TARGET=http://localhost:3000
